# demo | amazon
BOT_SOURCE=demo

# true: solo muestra; false: publica en Telegram
DRY_RUN=true
INTERVAL_MINUTES=30
DATABASE_PATH=runtime/chollo_radar.db
DEMO_FEED_PATH=data/demo_offers.json

# Producción compartida (si se omiten, el bot usa SQLite local)
SUPABASE_URL=
# Preferida: clave secreta sb_secret_*. También admite la service_role legacy.
SUPABASE_SECRET_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X (opcional; publicación directa mediante OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Amazon Creators API (España usa credenciales europeas 3.2)
# No son necesarias para el comando bootstrap previo a las 10 ventas.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.es
# Pausa mínima entre consultas de catálogo para evitar ráfagas
AMAZON_REQUEST_DELAY_SECONDS=1.1
